{
  "name": "@kitiumai/logger",
  "version": "2.0.0",
  "sideEffects": false,
  "type": "module",
  "description": "Enterprise-ready centralized logging system with Loki integration",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/esm/**/*.js",
    "dist/cjs/**/*.js",
    "dist/types/**/*.d.ts",
    "dist/types/**/*.d.ts.map",
    "!dist/**/__tests__/**",
    "!dist/**/examples/**",
    "!dist/**/*.test.*",
    "scripts/migrate.cjs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    },
    "./middleware": {
      "types": "./dist/types/middleware/express-middleware.d.ts",
      "import": "./dist/esm/middleware/express-middleware.js",
      "require": "./dist/cjs/middleware/express-middleware.js",
      "default": "./dist/esm/middleware/express-middleware.js"
    },
    "./middleware/next": {
      "types": "./dist/types/middleware/next-middleware.d.ts",
      "import": "./dist/esm/middleware/next-middleware.js",
      "require": "./dist/cjs/middleware/next-middleware.js",
      "default": "./dist/esm/middleware/next-middleware.js"
    },
    "./middleware/nest": {
      "types": "./dist/types/middleware/nest-logger.middleware.d.ts",
      "import": "./dist/esm/middleware/nest-logger.middleware.js",
      "require": "./dist/cjs/middleware/nest-logger.middleware.js",
      "default": "./dist/esm/middleware/nest-logger.middleware.js"
    },
    "./utils": {
      "types": "./dist/types/utils/logger-utils.d.ts",
      "import": "./dist/esm/utils/logger-utils.js",
      "require": "./dist/cjs/utils/logger-utils.js",
      "default": "./dist/esm/utils/logger-utils.js"
    },
    "./utils/console-capture": {
      "types": "./dist/types/utils/console-capture.d.ts",
      "import": "./dist/esm/utils/console-capture.js",
      "require": "./dist/cjs/utils/console-capture.js",
      "default": "./dist/esm/utils/console-capture.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kitium-ai/logger.git"
  },
  "homepage": "https://github.com/kitium-ai/logger#readme",
  "bugs": {
    "url": "https://github.com/kitium-ai/logger/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node build.cjs",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -b --noEmit",
    "dev": "ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist/esm dist/cjs dist/types",
    "setup:lint": "node node_modules/@kitiumai/lint/scripts/postinstall.js",
    "lint:tslint": "tslint -c tslint.json --project tsconfig.json '**/*.ts'",
    "lint:tslint:fix": "tslint -c tslint.json --project tsconfig.json --fix '**/*.ts'",
    "migrate": "node scripts/migrate.cjs",
    "migrate:help": "node scripts/migrate.cjs --help",
    "prepublishOnly": "npm run verify",
    "verify": "npm run lint && npm run test && npm run build",
    "changeset": "ensure-changeset && changeset",
    "version": "changeset version",
    "publish:set-token": "set-npm-token",
    "publish:setup": "set-npm-token",
    "publish:check": "npm whoami --registry https://registry.npmjs.org || npm login --registry https://registry.npmjs.org",
    "publish:login": "npm login --registry https://registry.npmjs.org",
    "publish:package": "pnpm run publish:check && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org",
    "publish:package:token": "pnpm run publish:setup && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org",
    "publish:package:otp": "pnpm run publish:check && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org --otp",
    "publish:dry-run": "pnpm publish --access public --no-git-checks --dry-run --registry https://registry.npmjs.org",
    "publish:dry-run:token": "pnpm run publish:setup && pnpm publish --access public --no-git-checks --dry-run --registry https://registry.npmjs.org",
    "publish:dry": "npm publish --dry-run",
    "release": "pnpm version && pnpm install --lockfile-only"
  },
  "keywords": [
    "logging",
    "logger",
    "structured-logging",
    "centralized-logging",
    "distributed-logging",
    "loki",
    "grafana-loki",
    "winston",
    "winston-logger",
    "observability",
    "monitoring",
    "telemetry",
    "opentelemetry",
    "tracing",
    "log-aggregation",
    "log-management",
    "express-middleware",
    "next-middleware",
    "nestjs-logger",
    "typescript",
    "nodejs",
    "node-logger",
    "enterprise",
    "production-ready",
    "microservices",
    "cloud-native",
    "devops",
    "sre",
    "log-rotation",
    "error-tracking",
    "performance-monitoring",
    "contextual-logging",
    "async-context",
    "request-tracking",
    "correlation-id",
    "kitium",
    "kitiumai"
  ],
  "author": "Kitium AI",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "axios": "^1.6.5",
    "dotenv": "^17.0.0",
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "winston-loki": "^6.1.1"
  },
  "devDependencies": {
    "@kitiumai/config": "^2.0.0",
    "@kitiumai/lint": "^2.0.0",
    "@kitiumai/scripts": "^1.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.15.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.4",
      "node-fetch": ">=2.6.7",
      "minimatch": ">=3.0.5",
      "ws": ">=7.5.10",
      "micromatch": ">=4.0.8"
    }
  }
}
