{
  "name": "@kitiumai/logger",
  "version": "1.5.0",
  "type": "module",
  "description": "Enterprise-ready centralized logging system with Loki integration",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware/express-middleware.d.ts",
      "import": "./dist/middleware/express-middleware.js",
      "require": "./dist/middleware/express-middleware.js",
      "default": "./dist/middleware/express-middleware.js"
    },
    "./middleware/next": {
      "types": "./dist/middleware/next-middleware.d.ts",
      "import": "./dist/middleware/next-middleware.js",
      "require": "./dist/middleware/next-middleware.js",
      "default": "./dist/middleware/next-middleware.js"
    },
    "./middleware/nest": {
      "types": "./dist/middleware/nest-logger.middleware.d.ts",
      "import": "./dist/middleware/nest-logger.middleware.js",
      "require": "./dist/middleware/nest-logger.middleware.js",
      "default": "./dist/middleware/nest-logger.middleware.js"
    },
    "./utils": {
      "types": "./dist/utils/logger-utils.d.ts",
      "import": "./dist/utils/logger-utils.js",
      "require": "./dist/utils/logger-utils.js",
      "default": "./dist/utils/logger-utils.js"
    },
    "./utils/console-capture": {
      "types": "./dist/utils/console-capture.d.ts",
      "import": "./dist/utils/console-capture.js",
      "require": "./dist/utils/console-capture.js",
      "default": "./dist/utils/console-capture.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kitium-ai/logger.git"
  },
  "homepage": "https://github.com/kitium-ai/logger#readme",
  "bugs": {
    "url": "https://github.com/kitium-ai/logger/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node build.cjs",
    "build:clean": "npm run clean && npm run build",
    "typecheck": "tsc -b --noEmit",
    "dev": "ts-node src/index.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rimraf dist",
    "setup:lint": "node node_modules/@kitiumai/lint/scripts/postinstall.js",
    "lint:tslint": "tslint -c tslint.json --project tsconfig.json '**/*.ts'",
    "lint:tslint:fix": "tslint -c tslint.json --project tsconfig.json --fix '**/*.ts'",
    "migrate": "node scripts/migrate.cjs",
    "migrate:help": "node scripts/migrate.cjs --help",
    "prepublishOnly": "npm run verify",
    "verify": "npm run lint && npm run test && npm run build",
    "changeset": "ensure-changeset && changeset",
    "version": "changeset version",
    "publish:set-token": "set-npm-token",
    "publish:setup": "set-npm-token",
    "publish:check": "npm whoami --registry https://registry.npmjs.org || npm login --registry https://registry.npmjs.org",
    "publish:login": "npm login --registry https://registry.npmjs.org",
    "publish:package": "pnpm run publish:check && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org",
    "publish:package:token": "pnpm run publish:setup && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org",
    "publish:package:otp": "pnpm run publish:check && pnpm publish --access public --no-git-checks --registry https://registry.npmjs.org --otp",
    "publish:dry-run": "pnpm publish --access public --no-git-checks --dry-run --registry https://registry.npmjs.org",
    "publish:dry-run:token": "pnpm run publish:setup && pnpm publish --access public --no-git-checks --dry-run --registry https://registry.npmjs.org",
    "publish:dry": "npm publish --dry-run",
    "release": "pnpm version && pnpm install --lockfile-only"
  },
  "keywords": [
    "logging",
    "structured-logging",
    "loki",
    "centralized",
    "winston",
    "observability",
    "kitium",
    "logger",
    "typescript",
    "nodejs",
    "kitiumai"
  ],
  "author": "Kitium AI",
  "license": "MIT",
  "dependencies": {
    "@kitiumai/config": "^0.1.4",
    "@kitiumai/lint": "^1.3.5",
    "@kitiumai/scripts": "^0.2.1",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "winston-loki": "^6.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.10",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "graphql": "^15.8.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
